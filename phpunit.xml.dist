<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheDirectory=".phpunit.cache">
  <testsuites>
    <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
    <testsuite name="Integration"><directory>tests/Integration</directory></testsuite>
    <testsuite name="Functional"><directory>tests/Functional</directory></testsuite>
  </testsuites>
  <php><env name="APP_ENV" value="test" force="true"/><env name="APP_DEBUG" value="1" force="true"/><env name="KERNEL_CLASS" value="App\Kernel"/></php>
</phpunit>
