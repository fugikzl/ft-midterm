<!DOCTYPE html><html><head><meta charset="UTF-8"><style>
body { font-family: DejaVu Sans, sans-serif; font-size: 10px; color: #172133; } h1 {font-size:22px;} table {border-collapse:collapse;width:100%;margin-bottom:20px;table-layout:fixed;} th,td{border:1px solid #ccd3df;padding:7px;word-wrap:break-word;} th{background:#edf1f7;text-align:left;} tr{page-break-inside:avoid;} footer{color:#657083;} .student{width:16%;}.assignment{width:19%;}.grade{width:7%;}
</style></head><body><h1>{{ course.name }} — student report</h1><p>Course #{{ course.id }} · Generated {{ generated }}{% if course.deletedAt %} · Archived{% endif %}</p>
<table><thead><tr><th class="student">Student / login</th><th class="assignment">Assignment</th><th>Deadline (UTC)</th><th>Submitted (UTC)</th><th class="grade">Grade</th><th>Comment</th></tr></thead><tbody>
{% for row in rows %}<tr><td>{{ row.username }}<br>{{ row.login }}</td><td>{{ row.assignment_name ?? 'No assignments' }}</td><td>{{ row.deadline ?? '—' }}</td><td>{{ row.submitted_at ?? 'Not submitted' }}</td><td>{{ row.grade ?? 'Ungraded' }}</td><td>{{ row.comment ?? '' }}</td></tr>{% else %}<tr><td colspan="6">No enrolled students.</td></tr>{% endfor %}</tbody></table>
<h2>Student averages</h2><table><tr><th>Student</th><th>Average of recorded grades</th><th>Graded assignments</th></tr>{% for row in averages %}<tr><td>{{ row.username }}</td><td>{{ row.average_grade is null ? 'Ungraded' : row.average_grade|number_format(2) }}</td><td>{{ row.graded_count }}</td></tr>{% endfor %}</table><footer>Missing grades are excluded from averages. Grades use a 0–100 scale.</footer></body></html>
