{
  "name": "midterm/university-backend",
  "description": "Fault-tolerant university course backend",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "~8.3.0",
    "ext-dom": "*",
    "ext-mbstring": "*",
    "ext-pcntl": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-redis": "*",
    "api-platform/doctrine-orm": "^4.4",
    "api-platform/symfony": "^4.4",
    "aws/aws-sdk-php": "^3.399",
    "baldinof/roadrunner-bundle": "^3.4",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^2.19",
    "doctrine/doctrine-migrations-bundle": "^3.7",
    "doctrine/orm": "^3.7",
    "dompdf/dompdf": "^3.1",
    "lexik/jwt-authentication-bundle": "^3.2",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/messenger": "7.4.*",
    "symfony/monolog-bundle": "^4.1",
    "symfony/property-info": "7.4.*",
    "symfony/redis-messenger": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3",
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^12.5",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/", "DoctrineMigrations\\": "migrations/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {"allow-plugins": {"symfony/runtime": true}, "sort-packages": true, "platform": {"php": "8.3.27"}},
  "scripts": {"test": "phpunit", "lint": "php bin/console lint:container"}
}
